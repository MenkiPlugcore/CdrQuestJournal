<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.menkiestes</groupId>
    <artifactId>CdrQuestJournal</artifactId>
    <version>1.0.0</version>
    <name>CdrQuestJournal</name>
    <description>Personal RPG quest journal bridge for BetonQuest with Citizens integration.</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <paper.version>1.21.11-R0.1-SNAPSHOT</paper.version>
        <betonquest.version>3.2.0</betonquest.version>
        <citizens.version>2.0.44-SNAPSHOT</citizens.version>
    </properties>

    <repositories>
        <repository><id>papermc</id><url>https://repo.papermc.io/repository/maven-public/</url></repository>
        <repository><id>betonquest-repo</id><url>https://repo.betonquest.org/betonquest/</url></repository>
        <repository><id>citizens-repo</id><url>https://maven.citizensnpcs.co/repo</url></repository>
    </repositories>

    <dependencies>
        <dependency><groupId>io.papermc.paper</groupId><artifactId>paper-api</artifactId><version>${paper.version}</version><scope>provided</scope></dependency>
        <dependency><groupId>org.betonquest</groupId><artifactId>betonquest</artifactId><version>${betonquest.version}</version><scope>provided</scope></dependency>
        <dependency><groupId>net.citizensnpcs</groupId><artifactId>citizensapi</artifactId><version>${citizens.version}</version><scope>provided</scope></dependency>
    </dependencies>

    <build>
        <finalName>CdrQuestJournal-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.1</version>
                <configuration><release>21</release></configuration>
            </plugin>
        </plugins>
    </build>
</project>
